# VOX Enhanced Voice Assistant - Environment Variables

# Server Configuration
PORT=3000
NODE_ENV=development

# STT (Speech-to-Text) Settings
STT_API_URL=https://api.openai.com/v1
STT_API_KEY=your-openai-api-key
STT_MODEL_ID=whisper-1
STT_RESPONSE_FORMAT=json
STT_TEMPERATURE=0
STT_ADDITIONAL_HEADERS={}

# LLM (Language Model) Settings
LLM_API_URL=https://api.openai.com/v1
LLM_API_KEY=your-openai-api-key
LLM_MODEL_ID=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_ADDITIONAL_HEADERS={}

# TTS (Text-to-Speech) Settings
TTS_API_URL=https://api.openai.com/v1
TTS_API_KEY=your-openai-api-key
TTS_MODEL_ID=tts-1
TTS_VOICE=alloy
TTS_SPEED=1.0
TTS_RESPONSE_FORMAT=mp3
TTS_ADDITIONAL_HEADERS={}

# Alternative: Edge TTS (no API key needed)
# TTS_API_URL=http://localhost:3000
# TTS_MODEL_ID=edge-tts
# TTS_VOICE=en-US-GuyNeural

# Alternative: Google Gemini (for all services)
# GEMINI_API_KEY=your-gemini-api-key
# LLM_MODEL_ID=gemini-1.5-flash
# STT_MODEL_ID=gemini-1.5-flash
# TTS_MODEL_ID=gemini-2.5-flash-preview-tts

# System Prompt
SYSTEM_PROMPT=You are a warm, helpful voice assistant named VOX. Keep responses concise and natural for speech. Use brief, conversational sentences.